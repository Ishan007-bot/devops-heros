{
  "overwrite": true,
  "dashboard": {
    "uid": "taskboard",
    "title": "TaskBoard Backend",
    "refresh": "10s",
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Backend targets UP",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 6
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(up{job=~\".*taskboard.*\"})",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ]
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Backend replicas (HPA)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 6
        },
        "targets": [
          {
            "refId": "A",
            "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"taskboard\"}",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ]
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Requests/sec",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 6,
          "h": 6
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(http_requests_total{namespace=\"taskboard\"}[1m]))",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          },
          "overrides": []
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "5xx error rate",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 6
        },
        "targets": [
          {
            "refId": "A",
            "expr": "(sum(rate(http_requests_total{namespace=\"taskboard\",status=\"5xx\"}[5m])) or vector(0)) / sum(rate(http_requests_total{namespace=\"taskboard\"}[5m]))",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit"
          },
          "overrides": []
        }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "HTTP requests/sec by handler",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 6,
          "w": 12,
          "h": 9
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (handler) (rate(http_requests_total{namespace=\"taskboard\"}[1m]))",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "legendFormat": "{{handler}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          },
          "overrides": []
        }
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "p95 latency by handler",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 12,
          "y": 6,
          "w": 12,
          "h": 9
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{namespace=\"taskboard\"}[1m])))",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "legendFormat": "{{handler}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": []
        }
      },
      {
        "id": 7,
        "type": "timeseries",
        "title": "Backend CPU by pod",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 15,
          "w": 12,
          "h": 9
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"taskboard\",container=\"backend\"}[1m]))",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "legendFormat": "{{pod}}"
          }
        ]
      },
      {
        "id": 8,
        "type": "timeseries",
        "title": "HPA current replicas",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 12,
          "y": 15,
          "w": 12,
          "h": 9
        },
        "targets": [
          {
            "refId": "A",
            "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"taskboard\"}",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "legendFormat": "current"
          }
        ]
      }
    ]
  }
}